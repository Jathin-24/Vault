{
  "name": "trustvault",
  "version": "1.0.0",
  "private": true,
  "description": "TrustVault — a document platform where the wrong person can never read a file, and you can prove who read it.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/apply-migrations.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs",
    "audit:verify": "node --env-file-if-exists=.env.local scripts/verify-audit-chain.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "next": "^15.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.10",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "pg": "^8.16.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
