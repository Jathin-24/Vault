# ── Supabase project (required) ──────────────────────────────────────────────
# Project URL + browser key: Supabase dashboard → Project Settings → API.
# (Newer dashboards call the anon key the "publishable key" — either name
# works, and the code accepts both. Set one of:)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key — SERVER ONLY. Never expose to the browser (Next.js only
# inlines NEXT_PUBLIC_* vars; this one must stay server-side).
SUPABASE_SERVICE_ROLE_KEY=

# ── Database connection (migrations only) ────────────────────────────────────
# Dashboard → Connect → Session mode (direct connection). Used by `npm run db:migrate`.
DATABASE_URL=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Upload limit in bytes (default 25 MB)
MAX_UPLOAD_BYTES=26214400
